1 ICON "ime.ico"
// Input mode indication (taskbar "Chinese/English"): dark fonts on light-colored taskbars, white
// fonts on dark-colored taskbars.
101 ICON "mode_zh_light.ico"
102 ICON "mode_en_light.ico"
103 ICON "mode_zh_dark.ico"
104 ICON "mode_en_dark.ico"
// Translation mode (Chinese + Translation) displays "Translation"; ordinary Wubi mode displays "中"
// (101/103).
105 ICON "mode_yi_light.ico"
106 ICON "mode_yi_dark.ico"

1 VERSIONINFO
FILEVERSION 0,1,1,0
PRODUCTVERSION 0,1,1,0
FILEOS 0x40004
FILETYPE 0x2
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "YiIME"
      VALUE "FileDescription", "YiIME TSF input method"
      VALUE "FileVersion", "0.1.1"
      VALUE "InternalName", "input_translation_tsf.dll"
      VALUE "LegalCopyright", "GPL-3.0"
      VALUE "OriginalFilename", "input_translation_tsf.dll"
      VALUE "ProductName", "YiIME"
      VALUE "ProductVersion", "0.1.1"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
