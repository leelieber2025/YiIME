1 ICON "tsf/ime.ico"

// Version string built from the numeric macros (windres drops quotes in -D values).
#define YIIME_STR(x) #x
#define YIIME_XSTR(x) YIIME_STR(x)
#define YIIME_VERSION YIIME_XSTR(YIIME_VERSION_MAJOR.YIIME_VERSION_MINOR.YIIME_VERSION_PATCH)
1 VERSIONINFO
FILEVERSION YIIME_VERSION_MAJOR,YIIME_VERSION_MINOR,YIIME_VERSION_PATCH,0
PRODUCTVERSION YIIME_VERSION_MAJOR,YIIME_VERSION_MINOR,YIIME_VERSION_PATCH,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "YiIME"
      VALUE "FileDescription", "YiIME input box and settings"
      VALUE "FileVersion", YIIME_VERSION
      VALUE "InternalName", "YiIME.exe"
      VALUE "LegalCopyright", "GPL-3.0"
      VALUE "OriginalFilename", "YiIME.exe"
      VALUE "ProductName", "YiIME"
      VALUE "ProductVersion", YIIME_VERSION
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
